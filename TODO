1 cursor-pagination:
  . interface PaginationParams:
      cursor
      limit
      field
      sortBy: 'desc' | 'asc'

  . interface filterParams:
      value
      field
      operator:

  - func applyCursorPagination(params: PaginationParams, query: QueryBuilder):
      if (!params.field) return query;
      if (params.filter):
          const op = params.sortBy === 'desc' ? '<' | '>'
          query = query.where(params.field, op, params.cursor);

      return query.sortBy(params.field, params.sortBy).limit(params.limit + 1);



